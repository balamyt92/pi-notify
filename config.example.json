{
  "enabled": true,
  "sound": true,
  "push": true,
  "minDurationSeconds": 0,
  "notifyOn": [
    "completed",
    "aborted",
    "error"
  ],
  "title": "Pi",
  "soundFile": null,
  "soundDurationMs": 5000,
  "volume": 0.4,
  "commands": {
    "darwin": {
      "sound": "afplay /System/Library/Sounds/Glass.aiff",
      "push": "osascript -e 'display notification (system attribute \"PI_NOTIFY_MESSAGE\") with title (system attribute \"PI_NOTIFY_TITLE\")'"
    },
    "win32": {
      "sound": "powershell -NoProfile -NonInteractive -EncodedCommand ",
      "push": "powershell -NoProfile -NonInteractive -EncodedCommand "
    },
    "wsl": {
      "sound": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
      "push": "powershell.exe -NoProfile -NonInteractive -EncodedCommand "
    },
    "linux": {
      "sound": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null || aplay /usr/share/sounds/alsa/Complete.oga 2>/dev/null || true",
      "push": "notify-send \"$PI_NOTIFY_TITLE\" \"$PI_NOTIFY_MESSAGE\""
    }
  }
}
